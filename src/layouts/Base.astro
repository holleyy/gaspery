---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Product, design & small software — a working notebook.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Autodiscovery. A linked post's headline points at the source, so the ★
        in a feed item is the only route back here — which assumes a reader can
        find the feed at all. Astro strips this comment from the output. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Alex Holley — a working notebook"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..600&family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <!-- Riso-duotone photo filter: grayscale, then remapped ink -> paper.
           Paired with a full-bleed teal halftone overlay (.riso-photo in
           global.css) so photography prints in the same two inks as
           everything else. Fixed to the light-mode tokens on purpose --
           a photographic negative is not a good dark-mode adaptation. -->
      <filter id="riso-duotone">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0      0      0      1 0"
        />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.137 0.965" />
          <feFuncG type="table" tableValues="0.125 0.945" />
          <feFuncB type="table" tableValues="0.098 0.902" />
        </feComponentTransfer>
      </filter>
    </svg>
    <slot />
  </body>
</html>
