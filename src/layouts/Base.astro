---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Product, design & small software. A working notebook.' } = Astro.props;

/* The whole audience arrives by link, so the preview card is the first
   surface most visitors ever see of this site. Canonical + OG/Twitter meta
   resolve against `site` in astro.config; the card itself is a static
   riso print at /og/card.png — same two inks, slightly out of register. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og/card.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F6F1E6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191712" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gaspery" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gaspery. A working notebook, printed in two inks, slightly out of register." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Autodiscovery. A linked post's headline points at the source, so the ★
        in a feed item is the only route back here — which assumes a reader can
        find the feed at all. Astro strips this comment from the output. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Alex Holley · a working notebook"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..600&family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <!-- Riso-duotone photo filter: grayscale, then remapped ink -> paper.
           Paired with a full-bleed teal halftone overlay (.riso-photo in
           global.css) so photography prints in the same two inks as
           everything else. Fixed to the light-mode tokens on purpose --
           a photographic negative is not a good dark-mode adaptation. -->
      <filter id="riso-duotone">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0.2126 0.7152 0.0722 0 0
                  0      0      0      1 0"
        />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.137 0.965" />
          <feFuncG type="table" tableValues="0.125 0.945" />
          <feFuncB type="table" tableValues="0.098 0.902" />
        </feComponentTransfer>
      </filter>
    </svg>
    <slot />
  </body>
</html>
