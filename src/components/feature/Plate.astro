---
/* A full-bleed artwork with its caption, optionally carrying the piece's
   display headline — which is what makes it the hero. Given no `src` it
   renders the copy alone rather than an empty frame or a fake placeholder,
   the same honest degradation appPages uses for a missing screenshot. */
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  captionLead?: string;
  eyebrow?: string;
  heading?: string;
  accent?: string;
  lede?: string;
  /* A feature post uses Plate more than once (a hero, then any number of
     mid-article plates), but a page may only have one <h1> — every other
     page on the site has exactly one. Default to 2 so a plate is safe by
     default; the caller sets `level={1}` on the single plate that is
     actually the page's hero. */
  level?: 1 | 2;
}
const { src, alt = '', caption, captionLead, eyebrow, heading, accent, lede, level = 2 } = Astro.props;

/* The mirror of `data-solo`. A plate with a `src` and no copy — "here is the
   mark, look at it" — otherwise keeps its copy column and renders 551px of
   nothing beside a squeezed image, which is the same dead-box shape a Spec
   with too many columns produces. If there is nothing to say, the figure
   takes the whole stage. */
const hasCopy = Boolean(eyebrow || heading || lede);
// Capitalized so Astro treats it as a dynamic tag rather than literal text —
// same pattern as `const Tag = app.url ? 'a' : 'div'` in AppsList.astro.
const Heading = level === 1 ? 'h1' : 'h2';
---
<section class="plate">
  <div class="feature-wrap plate__grid" data-solo={src ? undefined : ''} data-figure-only={hasCopy ? undefined : ''}>
    <div class="plate__copy">
      {eyebrow && <p class="feature-eyebrow">{eyebrow}</p>}
      {heading && (
        <Heading class="feature-h">{heading}{accent && <><br /><em>{accent}</em></>}</Heading>
      )}
      {lede && <p class="plate__lede">{lede}</p>}
    </div>
    {src && (
      <figure class="plate__figure">
        <img src={src} alt={alt} width="640" height="640" loading="eager" decoding="async" />
        {/* Two plain-text fields, not one field with `set:html`: `caption`
           is a Keystatic text field, and nothing in the GUI would signal
           that it's actually live HTML. RisoPhoto's `set:html` (the
           precedent once cited for this) escapes its caption *before*
           injecting it — its raw-HTML sink exists for whitespace fidelity,
           not markup pass-through. `captionLead` covers the one legitimate
           need for markup (a bold lead-in) without opening an HTML sink. */}
        {(captionLead || caption) && (
          <figcaption>
            {captionLead && <b>{captionLead}</b>}
            {captionLead && caption ? ' ' : ''}
            {caption}
          </figcaption>
        )}
      </figure>
    )}
  </div>
</section>

<style>
  .plate { padding: 56px 0 80px; }
  .plate__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.85fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .plate__grid[data-solo] { grid-template-columns: minmax(0, 1fr); }
  .plate__grid[data-figure-only] { grid-template-columns: minmax(0, 1fr); }
  .plate__grid[data-figure-only] .plate__figure { max-width: 640px; margin-inline: auto; }
  .plate__copy :global(.feature-h) em { font-style: italic; color: var(--color-brand-strong); }
  .plate__lede {
    margin-top: 24px;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--color-ink-secondary);
    max-width: 34em;
  }
  .plate__figure { margin: 0; }
  .plate__figure img { width: 100%; height: auto; }
  .plate__figure figcaption {
    margin-top: 16px;
    padding-top: 10px;
    border-top: 1px solid var(--color-hairline);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-secondary);
  }
  @media (max-width: 900px) {
    .plate__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
