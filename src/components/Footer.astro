---
import RegistrationMark from './RegistrationMark.astro';
---
<!-- No newsletter yet, so no Subscribe button: the CTA says so up front and
     offers the feed as the real path. When the letter exists, the link below
     becomes the actual subscribe destination. -->
<footer class="site-footer">
  <div class="subscribe">
    <span class="label">The notebook, by post</span>
    <div class="subscribe__line">
      One short letter a month, starting soon.
      <a class="subscribe__cta" href="/rss.xml">Follow by RSS meanwhile&nbsp;→</a>
    </div>
  </div>
  <div class="marks" aria-hidden="true">
    <RegistrationMark size={13} variant="cross" />
    <RegistrationMark size={13} variant="ring" />
    <RegistrationMark size={13} variant="cross" />
    <span class="label">Made with two inks</span>
  </div>
</footer>
