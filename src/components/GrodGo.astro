---
import Base from '../layouts/Base.astro';
import { BETA_URL } from '../lib/grod';

/* The click that counts. The page's "Join the beta" link lands here for a
   moment: the page is static, carries the site's tracker like every other
   page, and opens the beta email once the tracker has had a beat. The meta
   refresh is the fallback for a visitor with scripts off, and the visible
   link is the fallback for a browser that will not follow a refresh to a
   mailto. Same pattern as SkalGo and AfterframeGo.

   The beta buttons now link straight to the mailto and load this page in a
   hidden frame to be counted (GrodBar.astro); the frame never redirects. */
---
<Base
  title="Beta · GRØD"
  description="Joining the GRØD beta."
  fonts={['family=Atkinson+Hyperlegible+Next:wght@400;700']}
>
  <meta http-equiv="refresh" content={`2;url=${BETA_URL}`} slot="head" />
  <main id="main" class="grod-go" data-to={BETA_URL}>
    <p>Opening your mail app. If nothing happens, <a href={BETA_URL}>write to beta@gaspery.com</a> and we will send you the beta. No form, no tracker.</p>
  </main>
  <style is:global>
    .grod-go {
      min-height: 100dvh; display: grid; place-items: center; padding: 24px;
      font-family: 'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 18px;
      color: var(--color-ink); background: var(--color-paper);
    }
    .grod-go p { margin: 0; text-align: center; max-width: 30em; text-wrap: balance; }
    .grod-go a { color: var(--color-brand-strong); text-decoration: underline; text-underline-offset: 3px; }
  </style>
  <script>
    /* Give the deferred tracker a beat, then go. */
    const main = document.querySelector<HTMLElement>('.grod-go');
    const to = main?.dataset.to;
    /* Framed by the beta button to be counted: stay put, the visitor's mail
       app is already opening. */
    if (to && window.self === window.top) setTimeout(() => { window.location.href = to; }, 400);
  </script>
</Base>
