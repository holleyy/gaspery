---
import RegistrationMark from './RegistrationMark.astro';
import Pulse from './Pulse.astro';
import ThemeToggle from './ThemeToggle.astro';
import { isPulseEnabled, getLatestPost } from '../lib/bskyPulse';
import sidebar from '../data/sidebar/index.json';

interface NavItem { label: string; href: string; }
interface Link { label: string; href: string; }
interface Props {
  name?: string;
  role?: string;
  monogram?: string;
  current?: string;
  nav?: NavItem[];
  elsewhere?: Link[];
}
const {
  /* The rail is the site's masthead, so the identity defaults to the
     imprint. Pages pass only `current`; the props stay overridable. */
  name = 'Gaspery.',
  role = 'Words, design, tools & links',
  monogram = 'G',
  current = 'Writing',
  nav = [
    { label: 'Writing', href: '/writing' },
    { label: 'Apps', href: '/#apps' },
    { label: 'About', href: '/about' },
    { label: 'Now', href: '/now' },
  ],
  // Edited at /keystatic under "Sidebar"; pass the prop to override per-page.
  elsewhere = sidebar.elsewhere,
} = Astro.props;

const pulse = isPulseEnabled() ? await getLatestPost() : null;

/* aria-current is stricter than the visual marker: only the link whose href
   matches the real URL claims it. The marker (via `current`) may highlight
   Writing on `/` because home IS the writing stream — but assistive tech
   should never be told home is /writing. */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrentPage = (href: string) => (href.replace(/\/+$/, '') || '/') === pathname;

/* The homepage has no other headline now that the Hero is gone, so the
   wordmark's ink copy is its <h1>. Everywhere else the page's own title
   is the h1 and the wordmark stays a div. The ghost is decorative on
   every page and is never a heading. */
const isHome = pathname === '/';
---
<aside class="rail">
  <a class="identity" href="/" aria-label={`${name.replace(/\.$/, '')}, home`}>
    <div class="halftone" aria-hidden="true"></div>
    <div class="monogram">
      <div class="monogram__ghost"></div>
      <div class="monogram__ink">{monogram}</div>
    </div>
    <div class="identity__text">
      <div class="rail-wordmark">
        {/* Two stacked copies = the deliberate misregistration. Ghost is decorative. */}
        <div class="rail-wordmark__ghost" aria-hidden="true">{name}</div>
        {isHome
          ? <h1 class="rail-wordmark__ink">{name}</h1>
          : <div class="rail-wordmark__ink">{name}</div>}
      </div>
      <div class="label">{role}</div>
    </div>
  </a>

  <nav class="nav rail-group" aria-label="Primary">
    <div class="rail-group__title label">Index</div>
    {nav.map((item) => (
      <a
        href={item.href}
        data-current={item.label === current ? '' : undefined}
        aria-current={isCurrentPage(item.href) ? 'page' : undefined}
      >
        <span class="marker" aria-hidden="true">{item.label === current ? '→' : ''}</span>{item.label}
      </a>
    ))}
  </nav>

  <div class="elsewhere-group rail-group">
    <div class="rail-group__title label">Elsewhere</div>
    <div class="elsewhere">
      {elsewhere.map((item) => (
        <a href={item.href}>{item.label}<span class="ext" aria-hidden="true">↗</span></a>
      ))}
    </div>
  </div>

  {pulse && <Pulse post={pulse} />}

  <div class="theme-group rail-group" hidden>
    <div class="rail-group__title label">Appearance</div>
    <ThemeToggle />
  </div>

  <div class="colophon">
    <RegistrationMark size={16} />
    <p>Set in Merriweather &amp; Inter. Printed here in two inks, magenta &amp; teal, occasionally out of register.</p>
    {/* The print colophon's own sign-off: the author, then the run. The
        legal entity is stated once, in the statutory <Imprint /> at the foot
        of the page; the wordmark above is the brand mark, not the legal
        name, so the two may share a screen. */}
    <div class="label">Alex Holley</div>
    <div class="label">© MMXXVI · London</div>
  </div>
</aside>
