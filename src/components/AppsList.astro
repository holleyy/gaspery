---
import RegistrationMark from './RegistrationMark.astro';
import { statusLabel, type AppStatus } from '../lib/appStatus';

interface App {
  name: string;
  dek: string;
  meta: string;
  status: AppStatus;
  url?: string;
}
interface Now {
  building: string;
  reading: string;
  watching: string;
  listening: string;
  href?: string;
  linkLabel?: string;
}
interface Props {
  apps: App[];
  now?: Now;
}
const { apps, now } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<section class="stream" id="apps">
  <div class="stream__head">
    <div class="title-group">
      <RegistrationMark size={14} />
      <h2>Apps</h2>
    </div>
    <span class="label">Small tools</span>
  </div>

  {apps.map((app, i) => {
    const Tag = app.url ? 'a' : 'div';
    return (
      <Tag class="app" href={app.url}>
        <div class="app__num">{pad(i)}</div>
        <div class="app__body">
          <div class="app__head">
            <span class="app__name">{app.name}</span>
            <span class:list={['status', `status--${app.status}`]}>
              <span class="dot"></span>{statusLabel[app.status]}
            </span>
          </div>
          <div class="app__dek">{app.dek}</div>
          <div class="app__meta label">{app.meta}</div>
        </div>
      </Tag>
    );
  })}

  {now && (
    <div class="now-panel">
      <div class="now-panel__head">
        <span class="dot"></span>
        <span class="label">Now</span>
      </div>
      <div class="now-panel__row">
        <span class="now-panel__row-label">Building</span>
        <span class="now-panel__row-value">{now.building}</span>
      </div>
      <div class="now-panel__row">
        <span class="now-panel__row-label">Reading</span>
        <span class="now-panel__row-value">{now.reading}</span>
      </div>
      <div class="now-panel__row">
        <span class="now-panel__row-label">Watching</span>
        <span class="now-panel__row-value">{now.watching}</span>
      </div>
      <div class="now-panel__row">
        <span class="now-panel__row-label">Listening</span>
        <span class="now-panel__row-value">{now.listening}</span>
      </div>
      {now.href && <a class="now-panel__link" href={now.href}>{now.linkLabel ?? 'More'} →</a>}
    </div>
  )}
</section>
