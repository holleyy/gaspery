---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import RegistrationMark from '../components/RegistrationMark.astro';

const entry = await getEntry('about', 'index');
if (!entry) throw new Error('Missing about singleton at src/content/about/index.mdoc');
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} · Alex Holley`} description={entry.data.dek}>
  <div class="page">
    <Rail name="Alex Holley" role="Words, design, tools & links" monogram="A" current="About" />

    <main class="main" id="main">
      <section class="about-page">
        <h1 class="about-page__title">{entry.data.title}</h1>
        <p class="about-page__dek">{entry.data.dek}</p>

        <div class="about-page__prose">
          <Content />
        </div>

        <div class="about-page__end">
          <RegistrationMark size={14} />
          <a href="/">Back to the notebook →</a>
        </div>
      </section>
    </main>
  </div>
</Base>

<style>
  .about-page { max-width: 640px; display: flex; flex-direction: column; }
  .about-page__title {
    font-family: var(--font-serif); font-weight: 800;
    font-size: clamp(32px, 5vw, 44px); line-height: 1.12; letter-spacing: -0.02em;
  }
  .about-page__dek {
    margin-top: 14px; font-size: 18px; line-height: 1.55; color: var(--color-ink-secondary); max-width: 520px;
  }
  .about-page__prose {
    margin-top: 36px; padding-top: 28px; border-top: 2px solid var(--color-ink);
    display: flex; flex-direction: column; gap: 20px;
  }
  .about-page__prose :global(p) { font-size: var(--text-body); line-height: 1.7; max-width: 62ch; }
  .about-page__prose :global(a) {
    color: var(--color-brand-strong); text-decoration: underline; text-underline-offset: 2px;
  }
  .about-page__prose :global(a:hover) { color: var(--color-brand-strong-hover); }
  .about-page__end {
    display: flex; align-items: center; gap: 12px;
    margin-top: 8px; padding-top: 24px; border-top: 1px solid var(--color-hairline);
  }
  .about-page__end a { font-weight: 600; font-size: 14px; color: var(--color-brand-strong); }
  .about-page__end a:hover { color: var(--color-brand-strong-hover); }
</style>
