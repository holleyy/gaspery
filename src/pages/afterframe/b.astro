<script is:inline>
(function(){
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var clock=document.getElementById('clock'), t=22*3600+47*60+12;
  function pad(v){return (v<10?'0':'')+v;}
  // the NOW line sits at the clock's minute between the two time cells it falls in
  var cells=Array.prototype.slice.call(document.querySelectorAll('.tcell')), sched=document.getElementById('sched'), nowline=document.getElementById('nowline');
  function mins(s){ var p=s.split(':'); var m=(+p[0])*60+(+p[1]); return m<12*60? m+24*60 : m; }
  function placeNow(){
    if(!nowline||!cells.length) return;
    if(window.innerWidth<=980){ nowline.style.display='none'; return; } nowline.style.display='';
    var m=Math.floor(t/60); if(m<12*60) m+=24*60;
    var idx=-1; for(var i=0;i<cells.length;i++){ if(mins(cells[i].dataset.t)<=m) idx=i; }
    if(idx<0){ nowline.style.display='none'; return; }
    var a=cells[idx], b=cells[idx+1];
    var top=a.offsetTop; var span=b? (b.offsetTop-a.offsetTop) : a.offsetHeight; var frac=(m-mins(a.dataset.t))/(b? (mins(b.dataset.t)-mins(a.dataset.t)) : 15);
    nowline.style.top=(top+span*Math.min(1,frac))+'px';
  }
  if('ResizeObserver' in window){ new ResizeObserver(function(){ placeNow(); }).observe(sched); }
  function tick(){ t++; var h=Math.floor(t/3600)%24, mi=Math.floor(t%3600/60), s=t%60; clock.textContent=pad(h)+':'+pad(mi)+':'+pad(s); if(s===0) placeNow(); }
  tick(); placeNow(); window.addEventListener('resize', placeNow); window.addEventListener('load', placeNow);
  if(!reduce) setInterval(tick,1000);
  // keypad
  var kp=document.getElementById('keypad'), pin=document.getElementById('pin');
  function goPage(n){ var el=document.querySelector('[data-page="'+n+'"]'); if(el){ el.scrollIntoView({behavior: reduce?'auto':'smooth', block:'start'}); return true; } return false; }
  if(kp){ kp.addEventListener('submit', function(e){ e.preventDefault(); goPage(pin.value); }); pin.addEventListener('input', function(){ if(pin.value.length===3 && goPage(pin.value)) pin.blur(); }); pin.addEventListener('focus', function(){ pin.select(); }); }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting && document.activeElement!==pin) pin.value=e.target.dataset.page; }); },{rootMargin:'-40% 0px -50% 0px'});
    document.querySelectorAll('section[data-page]').forEach(function(p){ io.observe(p); });
  }
  // the runner rewrites itself, character by character, while the sharing block is on screen
  var runner=document.getElementById('runner'), rr=document.getElementById('runner-right'), KEEP='KEEP WHAT STAYED WITH YOU', SHARE='SHARE WHAT STAYED WITH YOU', cur=KEEP, rewriting=null;
  function setRunner(txt){ runner.innerHTML=''; for(var i=0;i<txt.length;i++){ var c=document.createElement('span'); c.className='ch'; c.textContent=txt[i]; runner.appendChild(c); } }
  function rewrite(to){
    if(cur===to) return; cur=to; if(rewriting) clearInterval(rewriting);
    var glyphs='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789', n=Math.max(to.length, runner.children.length), i=0;
    while(runner.children.length<n){ var c=document.createElement('span'); c.className='ch'; runner.appendChild(c); }
    rewriting=setInterval(function(){
      var chs=runner.children;
      for(var k=i;k<Math.min(i+3,n);k++){ if(chs[k]){ chs[k].textContent=glyphs[Math.floor(Math.random()*glyphs.length)]; chs[k].classList.add('flip'); } }
      if(i>0 && chs[i-1]){ chs[i-1].textContent=to[i-1]||''; chs[i-1].classList.remove('flip'); }
      i++;
      if(i>n){ clearInterval(rewriting); rewriting=null; setRunner(to); }
    }, reduce?0:34);
  }
  if(runner){ setRunner(KEEP);
    var p103=document.getElementById('p103');
    if(p103 && 'IntersectionObserver' in window){ new IntersectionObserver(function(es){ es.forEach(function(e){ rewrite(e.isIntersecting?SHARE:KEEP); if(rr) rr.textContent=e.isIntersecting?'P103 · the frame goes where you were already talking':'Tonight · 22:00 → closedown'; }); },{threshold:.2}).observe(p103); }
  }
  var sw=document.getElementById('crtsw'); if(sw){ sw.addEventListener('click', function(){ var on=document.body.classList.toggle('crt'); sw.setAttribute('aria-pressed', on); }); }
  // mosaic reveal on the stills
  function mosaic(img){
    // block-graphic reveal, fail-safe: the mosaic is drawn only from a decoded frame, checked for content,
    // starts on entry (or at once if already on screen), and is removed on a hard timer whatever happens
    var st=img.parentNode;
    function start(){
      if(!img.naturalWidth) return;
      var cv=document.createElement('canvas'); cv.className='mz'; cv.width=24; cv.height=14; cv.setAttribute('aria-hidden','true');
      var c=cv.getContext('2d'); if(!c) return;
      try{ c.imageSmoothingEnabled=false; c.drawImage(img,0,0,24,14); var d=c.getImageData(0,0,24,14).data, lit=0; for(var k=0;k<d.length;k+=4){ if(d[k]+d[k+1]+d[k+2]>30) lit++; } if(lit<20) return; }catch(e){ return; }
      st.appendChild(cv);
      var done=false; function go(){ if(done) return; done=true; cv.classList.add('go'); setTimeout(function(){ if(cv.parentNode) cv.parentNode.removeChild(cv); }, 1300); }
      var r=st.getBoundingClientRect(); if(r.bottom>0 && r.top<window.innerHeight){ setTimeout(go, 250); }
      else if('IntersectionObserver' in window){ var o=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ go(); o.disconnect(); } }); },{threshold:.2}); o.observe(st); }
      setTimeout(go, 2500);
    }
    if(img.decode){ img.decode().then(start, function(){}); } else if(img.complete && img.naturalWidth){ start(); } else { img.addEventListener('load', start, {once:true}); }
  }
  if(!reduce) document.querySelectorAll('img[data-mosaic]').forEach(mosaic);
})();
