<!-- ── Nothing changes on the television ────────────────────────────────── -->
<section class="playing" aria-labelledby="h-playing">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="h-playing">Save the scene without stopping&nbsp;it.</h2>
      <p class="measure">Afterframe is a companion, not a remote. It reads the active session and retrieves the selected moment from your own Plex server. It never pauses, seeks, or commands playback on Apple&nbsp;TV.</p>
    </div>

    <div class="timeline" aria-label="One strip: the frame you kept at 01:09:40 while the film plays on">
      <div class="strip" style="--n:8; --min:96px">
        <div class="edge t"><span>The Invite</span><span>2026</span><span></span><span></span><span></span><span></span><span class="kept">kept</span><span>playing on</span></div>
        <div class="frame scope" data-title="The Invite" data-tc="01:07:30" data-clock="22:41" data-mark=""><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-07-30-s.jpg" alt="The Invite: a man and a woman at a doorway"></div>
        <div class="frame scope" data-title="The Invite" data-tc="01:07:40" data-clock="22:41" data-mark=""><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-07-40-s.jpg" alt=""></div>
        <div class="frame scope" data-title="The Invite" data-tc="01:07:50" data-clock="22:41" data-mark=""><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-07-50-s.jpg" alt=""></div>
        <div class="frame scope" data-title="The Invite" data-tc="01:08:10" data-clock="22:41" data-mark="x"><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-08-10-s.jpg" alt=""><svg class="mark cross" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M14 14 L86 86 M84 12 L16 88"/></svg></div>
        <div class="frame scope" data-title="The Invite" data-tc="01:09:10" data-clock="22:42" data-mark=""><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-09-10-s.jpg" alt=""></div>
        <div class="frame scope" data-title="The Invite" data-tc="01:09:30" data-clock="22:43" data-mark=""><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-09-30-s.jpg" alt=""></div>
        <div class="frame scope is-kept" data-title="The Invite" data-tc="01:09:40" data-clock="22:43" data-mark="kept"><img loading="lazy" decoding="async" width="640" height="347" src="/shots/afterframe/frames/invite-01-09-40-s.jpg" alt="The Invite at 01:09:40, subtitled: But it could be. Could be tonight."><svg class="mark circle" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M52 6 C 78 4, 97 22, 96 50 C 95 80, 72 97, 46 95 C 20 93, 3 74, 5 48 C 7 22, 30 7, 55 8 C 62 8.5, 70 12, 76 17"/></svg></div>
