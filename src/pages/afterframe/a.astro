<script is:inline>
(function(){
  // One authored moment: the grease circle draws around the kept frame once the sheet is in view.
  var sheet=document.getElementById('sheet');
  if(!sheet) return;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){ sheet.classList.remove('draw'); return; }
  // Restart the draw when the hero re-enters after a long scroll away (once per visit is enough).
  var done=false;
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting && !done){ done=true; sheet.classList.add('draw'); io.disconnect(); } });
    },{threshold:.35});
    sheet.classList.remove('draw'); io.observe(sheet);
  }
  var kept=document.getElementById('kept'), sc=sheet.querySelector('.strips');
  if(kept && sc && sc.scrollWidth>sc.clientWidth+8){
    sc.scrollLeft=Math.max(0, kept.offsetLeft - (sc.clientWidth - kept.offsetWidth)/2);
  }
})();
(function(){
  document.documentElement.classList.add('js');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var CIRCLE='M52 6 C 78 4, 97 22, 96 50 C 95 80, 72 97, 46 95 C 20 93, 3 74, 5 48 C 7 22, 30 7, 55 8 C 62 8.5, 70 12, 76 17';
  // grease boxes around every primary action
  document.querySelectorAll('.btn-grease').forEach(function(b){
    var svg=document.createElementNS('http://www.w3.org/2000/svg','svg'); svg.setAttribute('class','scribble'); svg.setAttribute('viewBox','0 0 200 56'); svg.setAttribute('preserveAspectRatio','none'); svg.setAttribute('aria-hidden','true');
    var d='M8 10 C 60 6, 130 7, 194 9 C 196 22, 195 36, 193 47 C 130 50, 62 51, 6 48 C 4 36, 5 22, 7 12 C 30 10, 60 9, 80 9';
    ['g1','g2'].forEach(function(c){ var p=document.createElementNS('http://www.w3.org/2000/svg','path'); p.setAttribute('d',d); p.setAttribute('pathLength','1'); p.setAttribute('class',c); svg.appendChild(p); });
    var f=document.createElement('span'); f.className='fill'; f.setAttribute('aria-hidden','true');
    b.appendChild(svg); b.appendChild(f);
  });
  // the sheet's gloss follows the hand; the loupe reads the frame under it; a click marks the frame
  var sheet=document.getElementById('sheet'), loupe=document.getElementById('loupe'), sub=document.getElementById('loupe-sub'), hint=document.getElementById('loupe-hint');
  if(!sheet||!loupe) return;
  var fine=window.matchMedia('(hover:hover) and (pointer:fine)').matches;
  if(hint && fine) hint.hidden=false;
  sheet.addEventListener('pointermove', function(e){
    var r=sheet.getBoundingClientRect();
    sheet.style.setProperty('--mx', ((e.clientX-r.left)/r.width*100).toFixed(1)+'%');
    sheet.style.setProperty('--my', ((e.clientY-r.top)/r.height*100).toFixed(1)+'%');
    if(!fine) return;
    var fr=e.target.closest('.frame');
    if(!fr||!sheet.contains(fr)){ sheet.classList.remove('lens'); return; }
    var img=fr.querySelector('img'); var fr_r=fr.getBoundingClientRect();
    var px=(e.clientX-fr_r.left)/fr_r.width, py=(e.clientY-fr_r.top)/fr_r.height;
    loupe.style.left=(e.clientX-r.left)+'px'; loupe.style.top=(e.clientY-r.top)+'px';
    loupe.style.backgroundImage='url("'+img.getAttribute('src')+'")';
    loupe.style.backgroundSize=(fr_r.width*2.6)+'px auto';
    loupe.style.backgroundPosition=(px*100)+'% '+(py*100)+'%';
    var strip=fr.closest('.strip'); var idx=Array.prototype.indexOf.call(strip.querySelectorAll('.frame'), fr);
    var top=strip.querySelector('.edge.t'); var lbl=top? top.children[idx] : null;
    sub.textContent = lbl && lbl.textContent ? lbl.textContent : '';
    sheet.classList.add('lens');
  });
  var pencil=document.getElementById('pencil');
  sheet.addEventListener('pointermove', function(e){ if(!pencil||!fine) return; var r=sheet.getBoundingClientRect(); pencil.style.left=(e.clientX-r.left)+'px'; pencil.style.top=(e.clientY-r.top)+'px'; });
  sheet.addEventListener('pointerleave', function(){ sheet.classList.remove('lens'); });
  var strips=document.getElementById('strips'), frames=Array.prototype.slice.call(strips.querySelectorAll('.frame'));
  function mk(tag, cls, html){ var el=document.createElement(tag); if(cls) el.className=cls; if(html!=null) el.innerHTML=html; return el; }
  function edgeRow(cls, labels, keptIdx){ var e=mk('div','edge '+cls); labels.forEach(function(l,i){ e.appendChild(mk('span', keptIdx.indexOf(i)>-1?'kept':'', l)); }); return e; }
  function uniq(a){ return a.filter(function(v,i){ return a.indexOf(v)===i; }); }
  function build(mode){
    var groups=[];
    if(mode==='hour'){ for(var k=0;k<frames.length;k+=5){ var it=frames.slice(k,k+5); groups.push({label:it[0].dataset.clock+' → '+it[it.length-1].dataset.clock, extra:' · '+uniq(it.map(function(f){return f.dataset.title;})).join(', '), sub:'indexed every 10 s', items:it, n:5}); } }
    else { var by={}, order=[]; frames.forEach(function(f){ var t=f.dataset.title; if(!by[t]){ by[t]=[]; order.push(t); } by[t].push(f); }); order.forEach(function(t){ var it=by[t]; groups.push({label:t, extra:'', sub:it.length+(it.length===1?' frame':' frames')+' · '+it[0].dataset.tc+' → '+it[it.length-1].dataset.tc, items:it, n:8}); }); }
    strips.innerHTML='';
    groups.forEach(function(g){
      var t=mk('div','strip-title','<span><b>'+g.label+'</b>'+g.extra+'</span><span>'+g.sub+'</span>');
      var st=mk('div','strip'); st.style.setProperty('--n', g.n);
      var kept=[]; g.items.forEach(function(f,i){ if(f.dataset.mark==='kept') kept.push(i); });
      st.appendChild(edgeRow('t', g.items.map(function(f){ return mode==='hour'?f.dataset.clock:f.dataset.tc; }), kept));
      g.items.forEach(function(f){ st.appendChild(f); });
      st.appendChild(edgeRow('b', g.items.map(function(f){ return mode==='hour'?f.dataset.tc:f.dataset.clock; }), kept));
      strips.appendChild(t); strips.appendChild(st);
    });
  }
  var shareSecs=[document.getElementById('sharing'), document.getElementById('went')].filter(Boolean), shareVis={};
  if(shareSecs.length && 'IntersectionObserver' in window){
    var sio=new IntersectionObserver(function(es){ es.forEach(function(e){ shareVis[e.target.id]=e.isIntersecting; }); var any=Object.keys(shareVis).some(function(k){ return shareVis[k]; }); document.body.classList.toggle('sharing', any); var rr=document.getElementById('runner-right'); if(rr) rr.textContent=any?'Sharing · the frame goes where you were already talking':'Proof sheet · 22 Sep 2026'; },{threshold:.25});
    shareSecs.forEach(function(s){ sio.observe(s); });
  }
  document.querySelectorAll('.toggle .tg').forEach(function(b){ b.addEventListener('click', function(){ document.querySelectorAll('.toggle .tg').forEach(function(x){ x.classList.remove('on'); x.setAttribute('aria-pressed','false'); }); b.classList.add('on'); b.setAttribute('aria-pressed','true'); build(b.dataset.mode); }); });
  // freehand grease: press and drag writes on the sheet; a short press is a click and circles the frame
  var ink=document.getElementById('ink'), drawing=null, moved=0, sndOn=false, ac=null;
  function scratch(){
    if(!sndOn) return;
    try{
      ac=ac||new (window.AudioContext||window.webkitAudioContext)();
      var len=Math.floor(ac.sampleRate*0.14), buf=ac.createBuffer(1,len,ac.sampleRate), d=buf.getChannelData(0), last=0;
      for(var i=0;i<len;i++){ var w=Math.random()*2-1; last=(last+0.03*w)/1.03; d[i]=last*6*(1-i/len); }
      var src=ac.createBufferSource(); src.buffer=buf; var f=ac.createBiquadFilter(); f.type='bandpass'; f.frequency.value=1800; f.Q.value=.8; var g=ac.createGain(); g.gain.value=.5;
      src.connect(f); f.connect(g); g.connect(ac.destination); src.start();
    }catch(e){}
  }
  var sndBtn=document.getElementById('snd'); if(sndBtn) sndBtn.addEventListener('click', function(){ sndOn=!sndOn; sndBtn.textContent=sndOn?'sound on':'sound off'; sndBtn.setAttribute('aria-pressed', sndOn); sndBtn.classList.toggle('on', sndOn); if(sndOn) scratch(); });
  var wipeBtn=document.getElementById('wipe'); if(wipeBtn) wipeBtn.addEventListener('click', function(){ if(ink) ink.innerHTML=''; sheet.querySelectorAll('.frame .mark.circle').forEach(function(m){ if(m.parentNode.dataset.mark!=='kept') m.remove(); }); });
  if(ink && fine){
    var pts=[];
    function pt(e){ var r=sheet.getBoundingClientRect(); return [e.clientX-r.left, e.clientY-r.top]; }
    function d(){ return pts.map(function(p,i){ return (i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1); }).join(' '); }
    sheet.addEventListener('pointerdown', function(e){ if(e.button!==0||e.target.closest('button, a')) return; pts=[pt(e)]; moved=0; var g=document.createElementNS('http://www.w3.org/2000/svg','path'); g.setAttribute('class','ghost'); var p=document.createElementNS('http://www.w3.org/2000/svg','path'); drawing=[g,p]; ink.appendChild(g); ink.appendChild(p); scratch(); });
    sheet.addEventListener('pointermove', function(e){ if(!drawing) return; var q=pt(e), l=pts[pts.length-1]; moved+=Math.hypot(q[0]-l[0], q[1]-l[1]); pts.push(q); var s=d(); drawing[0].setAttribute('d', s); drawing[1].setAttribute('d', s); });
    function up(){ if(!drawing) return; if(moved<10){ drawing[0].remove(); drawing[1].remove(); } drawing=null; }
    sheet.addEventListener('pointerup', up); sheet.addEventListener('pointercancel', up); sheet.addEventListener('pointerleave', up);
  }
  sheet.addEventListener('click', function(e){
    if(moved>=10){ moved=0; return; }
    var fr=e.target.closest('.frame'); if(!fr||!sheet.contains(fr)) return;
    var existing=fr.querySelector('.mark.circle');
    if(existing){ if(fr.id!=='kept') existing.remove(); return; }
    var svg=document.createElementNS('http://www.w3.org/2000/svg','svg'); svg.setAttribute('class','mark circle'); svg.setAttribute('viewBox','0 0 100 100'); svg.setAttribute('preserveAspectRatio','none'); svg.setAttribute('aria-hidden','true');
    var p=document.createElementNS('http://www.w3.org/2000/svg','path'); p.setAttribute('d',CIRCLE); p.setAttribute('pathLength','1'); svg.appendChild(p); fr.appendChild(svg);
    if(!reduce){ p.style.strokeDasharray='1 1'; p.style.strokeDashoffset='1'; p.style.animation='draw .8s cubic-bezier(.3,.6,.2,1) forwards'; }
    var strip=fr.closest('.strip'); var idx=Array.prototype.indexOf.call(strip.querySelectorAll('.frame'), fr);
    var bot=strip.querySelector('.edge.b'); if(bot && bot.children[idx]) bot.children[idx].classList.add('kept');
  });
})();
</script>
