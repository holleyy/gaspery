---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RegistrationMark from '../../components/RegistrationMark.astro';
import Imprint from '../../components/Imprint.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import FeatureArticle from '../../components/FeatureArticle.astro';
import { isLink, isFeature, sourceDomain } from '../../lib/links';

export async function getStaticPaths() {
  /* Drafts stay reachable under `astro dev` so a post can be previewed at its
     real URL; production never builds a page for one. */
  const posts = (await getCollection('writing'))
    .filter((post) => !(import.meta.env.PROD && post.data.draft));
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
/* The `{' '}` wrapping the ternary below is not decorative: Astro trims
   whitespace-only text immediately touching a `{}` expression when that
   expression is a tag's only child, and this ternary replaces the literal
   <main> that used to sit there directly as <Base>'s only child. Losing
   that whitespace is a byte-for-byte diff on every existing page —
   scripts/verify-parity.sh catches it — so it is restored explicitly.

   ThemeToggle is passed into FeatureArticle as a slot, not imported inside
   FeatureArticle.astro itself: a second static import of ThemeToggle within
   this route's own compiled graph is enough for the bundler to split its
   styles into a shared chunk instead of this page's own inline block,
   flipping every writing post's <style> — feature or not. One import here
   keeps that decision exactly as it was.

   The standard branch below (<main class="article">...</main>) is emitted
   verbatim, indentation included, and must stay that way: a formatter pass
   that reindents it changes every existing writing page's HTML, the same
   class of break as the whitespace this comment already defends. */
---
<Base title={`${post.data.title} · Alex Holley`} description={post.data.dek} mono={isFeature(post.data)}>
  {' '}{isFeature(post.data) ? (
    <FeatureArticle post={post}>
      <ThemeToggle slot="theme-toggle" />
      <Content />
    </FeatureArticle>
  ) : (
  <main class="article" id="main">
    <a class="back" href="/">← Alex Holley</a>

    <div class="article__meta">
      <span class="label">{fmt.toUpperCase()}</span>
      <span class="sep" aria-hidden="true">/</span>
      <span class="label">{isLink(post.data) ? sourceDomain(post.data.sourceUrl) : post.data.readingTime}</span>
      <ThemeToggle />
    </div>

    {/* .article__dek below must stay outside this ternary — moving it into
        either branch changes Astro's whitespace serialization and breaks
        essay-markup parity (the regression fixed by commit 56796fa). */
    isLink(post.data) ? (
      <h1 class="article__title">
        <a class="article__source" href={post.data.sourceUrl}>{post.data.title}</a><span class="article__out" aria-hidden="true">↗</span>
      </h1>
    ) : (
      <h1 class="article__title">{post.data.title}</h1>
    )}
    <p class="article__dek">{post.data.dek}</p>

    <div class="prose">
      <Content />
    </div>

    <div class="article__end">
      {isLink(post.data)
        ? <span class="article__star" aria-hidden="true">★</span>
        : <RegistrationMark size={14} />}
      <a href="/">Back to the notebook →</a>
    </div>

    <Imprint />
  </main>
  )}{' '}
</Base>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 72px 24px 96px;
    display: flex;
    flex-direction: column;
  }
  .back {
    font-weight: 600;
    font-size: 14px;
    color: var(--color-brand-strong);
    margin-bottom: 40px;
  }
  .back:hover { color: var(--color-brand-strong-hover); }
  .article__meta { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .article__meta .sep { color: var(--color-hairline); }
  .article__meta > :global(.theme-toggle) { margin-left: auto; }
  .article__title {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: clamp(32px, 6vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .article__dek {
    margin-top: 16px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-ink-secondary);
    max-width: 560px;
  }
  .prose {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 2px solid var(--color-ink);
    font-size: 18px;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.25;
    margin: 40px 0 12px;
  }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(a) { color: var(--color-brand-strong); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(a:hover) { color: var(--color-brand-strong-hover); }

  .article__source { color: inherit; }
  .article__source:hover { color: var(--color-brand-bright); }
  .article__out { margin-left: 10px; font-size: 24px; color: var(--color-teal-ink); }
  .article__star { font-size: 16px; color: var(--color-teal-ink); }

  /* Quoting a source — the tint block, so their voice and yours are
     visually separable. Applies to essays too; the site had no
     blockquote style at all before this. */
  .prose :global(blockquote) {
    margin: 28px 0 26px;
    padding: 22px 26px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }
  .prose :global(blockquote p) {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(blockquote cite) {
    display: block;
    margin-top: 12px;
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal-ink);
  }

  .article__end {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }
  .article__end a { font-weight: 600; font-size: 14px; color: var(--color-brand-strong); }
  .article__end a:hover { color: var(--color-brand-strong-hover); }
</style>
