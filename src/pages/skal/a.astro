  <footer class="skal-status">
    <div class="tabs" role="tablist" aria-label="View">
      <button class="tab" role="tab" id="tab-code" aria-selected="false" data-view="code">Code</button>
      <button class="tab" role="tab" id="tab-live" aria-selected="true" data-view="live">Live</button>
      <button class="tab tab--split" role="tab" id="tab-split" aria-selected="false" data-view="split">Split</button>
    </div>
    <span class="status__hint" id="hint">This page switches like a document.</span>
    <span class="status__spacer"></span>
    <span class="status__stats"><span id="words">— words</span><span class="status__enc">UTF-8</span></span>
  </footer>
