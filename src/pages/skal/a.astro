<script>
(function () {
  var win = document.getElementById('win');
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
  var live = document.getElementById('live');
  var code = document.getElementById('code');
  var hint = document.getElementById('hint');
  var narrow = window.matchMedia('(max-width: 860px)');
  var hints = { live: 'This page switches like a document.', code: 'The same page, as the file it was written as.', split: 'Linked. Scroll either side.' };

  function setView(v, persist) {
    if (v === 'split' && narrow.matches) v = 'live';
    var prev = win.getAttribute('data-view');
    win.setAttribute('data-view', v);
    if (prev !== v) {
      var incoming = v === 'code' ? code : v === 'live' ? live : code;
      incoming.classList.remove('is-in'); void incoming.offsetWidth; incoming.classList.add('is-in');
    }
    tabs.forEach(function (t) { t.setAttribute('aria-selected', String(t.dataset.view === v)); });
    hint.textContent = hints[v];
    if (persist) { try { localStorage.setItem('skal-view', v); } catch (e) {} }
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { setView(t.dataset.view, true); }); });
  Array.prototype.forEach.call(document.querySelectorAll('.sw'), function (b) { b.addEventListener('click', function () { setView(b.dataset.view, true); window.scrollTo({ top: 0, behavior: calmScroll() }); }); });
  function calmScroll() { return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'; }
  document.addEventListener('keydown', function (e) {
    if (!(e.ctrlKey && e.metaKey)) return;
    var map = { '1': 'code', '2': 'live', '3': 'split' };
    if (map[e.key]) { e.preventDefault(); setView(map[e.key], true); }
  });
  narrow.addEventListener('change', function () { if (win.getAttribute('data-view') === 'split' && narrow.matches) setView('live', false); });

  /* Word count, from the rendered document, like the status bar's. */
  var text = document.getElementById('doc').innerText || '';
  var n = text.trim().split(/\s+/).filter(Boolean).length;
  document.getElementById('words').textContent = n + ' words';

  /* Linked scrolling in Split: proportional, and only from the pane the pointer is in. */
  var lock = null;
  function link(a, b) {
    a.addEventListener('scroll', function () {
      if (win.getAttribute('data-view') !== 'split' || lock === b) return;
      lock = a;
      var ra = a.scrollTop / Math.max(1, a.scrollHeight - a.clientHeight);
      b.scrollTop = ra * (b.scrollHeight - b.clientHeight);
      requestAnimationFrame(function () { lock = null; });
    }, { passive: true });
  }
  link(live, code); link(code, live);

  var stored = null;
  try { stored = localStorage.getItem('skal-view'); } catch (e) {}
  if (stored === 'code' || stored === 'split') setView(stored, false);
})();
</script>

</Base>
