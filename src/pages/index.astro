---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import WritingList from '../components/WritingList.astro';
import AppsList from '../components/AppsList.astro';
import Footer from '../components/Footer.astro';
import home from '../data/home/index.json';
import { newestEssayId, toPostProps } from '../lib/links';

// Writing — newest first, drafts hidden, latest flagged "New".
const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const newestId = newestEssayId(posts);
const postProps = posts.map((p) => toPostProps(p, newestId));

// Apps — ordered small tools.
const apps = (await getCollection('apps'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((a) => ({
    name: a.data.name,
    dek: a.data.dek,
    meta: a.data.meta,
    status: a.data.status,
    url: a.data.url,
  }));
---
<Base title="Alex Holley · a working notebook">
  <div class="page">
    <Rail name="Alex Holley" role="Words, design, tools & links" monogram="A" current="Writing" />

    <main class="main" id="main">
      <Hero
        eyebrow={home.hero.eyebrow}
        title={home.hero.title}
        intro={home.hero.intro}
      />

      <div class="streams">
        <WritingList posts={postProps} />
        <AppsList
          apps={apps}
          now={{
            building: home.nowSummary.building,
            reading: home.nowSummary.reading,
            watching: home.nowSummary.watching,
            listening: home.nowSummary.listening,
            href: '/now',
            linkLabel: home.nowSummary.linkLabel,
          }}
        />
      </div>

      <Footer />
    </main>
  </div>
</Base>
