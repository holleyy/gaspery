---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import WritingList from '../components/WritingList.astro';
import AppsList from '../components/AppsList.astro';
import Footer from '../components/Footer.astro';

// Writing — newest first, drafts hidden, latest flagged "New".
const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const newestId = posts[0]?.id;
const postProps = posts.map((p) => ({
  href: `/writing/${p.id}`,
  title: p.data.title,
  dek: p.data.dek,
  date: p.data.date,
  readingTime: p.data.readingTime,
  isNew: p.id === newestId,
}));

// Apps — ordered small tools.
const apps = (await getCollection('apps'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((a) => ({
    name: a.data.name,
    dek: a.data.dek,
    meta: a.data.meta,
    status: a.data.status,
    url: a.data.url,
  }));
---
<Base title="Alex Holley — a working notebook">
  <div class="page">
    <Rail name="Alex Holley" role="Words, design, tools & links" monogram="A" current="Writing" />

    <main class="main">
      <Hero
        eyebrow="A working notebook · Est. MMXXVI"
        title="Things people should see; things I want to remember."
        intro="Essays & experiments. But also unloading my favourites folder, because there's a lot to share."
      />

      <div class="streams">
        <WritingList posts={postProps} />
        <AppsList
          apps={apps}
          now={{
            building: 'Teaching GRØD to spot meetings on its own, and folding this very two-ink palette into the app.',
            reading: 'The Faith of Beasts — James S. A. Corey',
            watching: 'The Agency — Paramount+',
            listening: 'Every single pod about The Odyssey',
            href: '/now',
            linkLabel: 'More on all this',
          }}
        />
      </div>

      <Footer />
    </main>
  </div>
</Base>
