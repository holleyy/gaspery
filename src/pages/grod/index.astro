---
import {
  GROD_VARIANT_COOKIE,
  GROD_VARIANT_MAX_AGE,
  resolveGrodVariant,
} from '../../lib/grod';

/* On-demand: the only route in the /grod test that runs on the Worker.
   It never renders anything; it picks an arm and redirects. See lib/grod.ts. */
export const prerender = false;

const { variant, fresh } = resolveGrodVariant(
  Astro.url.searchParams.get('v'),
  Astro.cookies.get(GROD_VARIANT_COOKIE)?.value,
);

if (fresh) {
  Astro.cookies.set(GROD_VARIANT_COOKIE, variant, {
    path: '/grod',
    maxAge: GROD_VARIANT_MAX_AGE,
    sameSite: 'lax',
    secure: true,
    httpOnly: true,
  });
}

Astro.response.headers.set('cache-control', 'private, no-store');
return Astro.redirect(`/grod/${variant}/`, 302);
---
