---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import RegistrationMark from '../components/RegistrationMark.astro';
import Imprint from '../components/Imprint.astro';
import now from '../data/now/index.json';
import { renderInline } from '../lib/inlineMarkdoc';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const d = new Date(now.updated);
const updatedLabel = `${String(d.getUTCDate()).padStart(2, '0')} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
---
<Base
  title="Now · Alex Holley"
  description="What I'm building, reading, watching, and listening to right now."
>
  <div class="page">
    <Rail name="Alex Holley" role="Words, design, tools & links" monogram="A" current="Now" />

    <main class="main" id="main">
      <section class="now-page">
        <div class="now-page__meta label">Updated {updatedLabel}</div>
        <h1 class="now-page__title">{now.title}</h1>
        <p class="now-page__dek">{now.dek}</p>

        {now.entries.flatMap((entry, i) => [
          i > 0 ? ' ' : null,
          <div class="now-page__entry">
            <h2>{entry.heading}</h2>
            <p set:html={renderInline(entry.body)} />
          </div>,
        ])}

        <div class="now-page__end">
          <RegistrationMark size={14} />
          <a href="/">Back to the notebook →</a>
        </div>

        <Imprint />
      </section>
    </main>
  </div>
</Base>

<style>
  .now-page { max-width: 640px; display: flex; flex-direction: column; }
  .now-page__meta { margin-bottom: 14px; }
  .now-page__title {
    font-family: var(--font-serif); font-weight: 800;
    font-size: clamp(32px, 5vw, 44px); line-height: 1.12; letter-spacing: -0.02em;
  }
  .now-page__dek {
    margin-top: 14px; font-size: 18px; line-height: 1.55; color: var(--color-ink-secondary); max-width: 520px;
  }
  .now-page__entry {
    margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--color-hairline);
    display: flex; flex-direction: column; gap: 10px;
  }
  .now-page__entry:first-of-type { margin-top: 40px; padding-top: 32px; border-top: 2px solid var(--color-ink); }
  .now-page__entry h2 {
    font-family: var(--font-serif); font-weight: 700; font-size: var(--text-title); color: var(--color-ink);
  }
  .now-page__entry p {
    font-size: var(--text-body); line-height: 1.65; color: var(--color-ink-secondary); max-width: 60ch;
  }
  .now-page__entry :global(em) { font-style: italic; color: var(--color-ink); }
  .now-page__end {
    display: flex; align-items: center; gap: 12px;
    margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--color-hairline);
  }
  .now-page__end a { font-weight: 600; font-size: 14px; color: var(--color-brand-strong); }
  .now-page__end a:hover { color: var(--color-brand-strong-hover); }
</style>
