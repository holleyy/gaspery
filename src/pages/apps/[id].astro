---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppPageHeader from '../../components/AppPageHeader.astro';
import Imprint from '../../components/Imprint.astro';
import QuietAppBody from '../../components/QuietAppBody.astro';
import EditorialAppBody from '../../components/EditorialAppBody.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';

export async function getStaticPaths() {
  const pages = await getCollection('appPages');
  const apps = await getCollection('apps');
  return pages.map((page) => {
    const app = apps.find((a) => a.id === page.id);
    /* Keystatic keeps `apps` and `appPages` as separate collections, so
       renaming one does not rename the other — and an orphaned page used to
       fail the whole build with an untraceable "reading 'data'" TypeError.
       Name both files instead; an app page with no roster entry is genuinely
       broken, so stopping here is right. */
    if (!app) {
      throw new Error(
        `appPages/${page.id}.mdoc has no matching apps/${page.id}.yaml. ` +
          `Rename the two together, or add the missing roster entry.`
      );
    }
    return { params: { id: page.id }, props: { page, app } };
  });
}

const { page, app } = Astro.props;
const { Content } = await render(page);
---
<Base title={`${app.data.name} · Gaspery`} description={app.data.dek}>
  {/* A page carrying a real screenshot gets the wider stage (a Mac window
      shrunk into a prose column is a smudge, not proof); a quiet page with
      only the placeholder stays at the reading measure. */}
  <main class:list={['app-page', (page.data.template === 'editorial' || page.data.shot) && 'app-page--wide']} id="main">
    <div class="app-page__topbar">
      <a class="app-page__back" href="/">&larr; Gaspery</a>
      <ThemeToggle />
    </div>

    <AppPageHeader name={app.data.name} meta={app.data.meta} status={app.data.status} />

    {page.data.template === 'quiet' ? (
      <QuietAppBody image={page.data.shot} alt={page.data.alt}><Content /></QuietAppBody>
    ) : (
      <EditorialAppBody spreads={page.data.spreads ?? []}><Content /></EditorialAppBody>
    )}

    {app.data.site && (
      /* An app with a site of its own gets one plain door to it. The site
         is built in the app's world, not this one, so the link says where
         it goes rather than what it is. */
      <p class="app-page__site">
        <a href={app.data.site}>Visit the {app.data.name} site &rarr;</a>
        <span>{app.data.name} has a home of its own, built in its own world.</span>
      </p>
    )}

    {/* App pages are the marketing URLs App Store review actually visits, so
        the full statutory imprint closes them. */}
    <footer><Imprint /></footer>
  </main>
</Base>

<style>
  .app-page__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .app-page__site {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }
  .app-page__site a {
    font-weight: 600;
    color: var(--color-brand-strong);
  }
  .app-page__site a:hover { color: var(--color-brand-strong-hover); }
  .app-page__site span { color: var(--color-ink-secondary); }
</style>
